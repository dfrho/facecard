# API Keys
# Create a .env.local file with these values filled in
OPENAI_API_KEY=your_openai_api_key_here
HEYGEN_API_KEY=your_heygen_api_key_here

# Feature Flags
ENABLE_OPENAI=true
ENABLE_HEYGEN=false

# Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=5242880  # 5MB
NEXT_PUBLIC_SCRIPT_MAX_LENGTH=1000
NEXT_PUBLIC_SUPPORTED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
